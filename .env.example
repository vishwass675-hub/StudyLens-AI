# ==============================================================================
# StudyLens AI - Environment Configuration Template
# ==============================================================================

# Backend Service
PROJECT_NAME="StudyLens AI - Academic AI Tutor"
API_V1_PREFIX="/api"

# Allowed CORS Origins (JSON list or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# File & Ingestion Limits
MAX_FILE_SIZE_MB=50
MAX_PAGES_LIMIT=200

# Chunking & Embedding Parameters
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
EMBEDDING_MODEL="local-minilm"
DEFAULT_TOP_K=5
SIMILARITY_THRESHOLD=0.30

# Ollama Cloud Configuration (Nemotron 3 Nano 30B Cloud)
# Obtain your API key from https://ollama.com/
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=nemotron-3-nano:30b-cloud
OLLAMA_TIMEOUT_SECONDS=60.0
